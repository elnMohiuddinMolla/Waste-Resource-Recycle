# ==============================================================================
# WRR Management System - Backend Environment Configuration
# Copy this file to .env and fill in the values. Never commit .env.
# ==============================================================================

# Server port (serves both the API and the frontend pages)
PORT=5000

# Database (XAMPP defaults: user root, empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wrr_db

# JWT secret: at least 32 random characters (tokens expire after 7 days).
# The server refuses to start with this example value. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# development | production (production adds the Secure flag to the cookie)
NODE_ENV=development
